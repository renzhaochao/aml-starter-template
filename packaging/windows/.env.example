# First launch automatically creates .env with a random API key.
# Edit the generated .env and restart the server to change settings.
AML_API_KEY=replace-with-your-own-long-random-key
AML_AUTH_MODE=bearer
AML_HOST=0.0.0.0
AML_PORT=8000
MEMORY_DB_PATH=./data/memory.db
RETRIEVAL_MODE=hybrid
RETRIEVAL_CANDIDATE_LIMIT=200
RETRIEVAL_CONTEXT_WINDOW=1
RETRIEVAL_CHAR_BUDGET=24000
