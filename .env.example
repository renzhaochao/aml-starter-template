# 认证：生产必须设置（python -c "import secrets; print(secrets.token_hex(32))"）
# 留空 = 本地免认证
AML_API_KEY=
AML_AUTH_MODE=bearer

# SQLite 存储路径
MEMORY_DB_PATH=./data/memory.db

# hybrid（三路融合） | bm25（词法基线） | abstain（空结果）
RETRIEVAL_MODE=hybrid
RETRIEVAL_CANDIDATE_LIMIT=200
RETRIEVAL_CONTEXT_WINDOW=1
RETRIEVAL_CHAR_BUDGET=24000
